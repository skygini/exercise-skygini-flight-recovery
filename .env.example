# Copy to .env (optional). Every value has a working default.

PORT=4000
LOG_LEVEL=info                    # debug | info | warn | error | silent

# Provider scenario used when a request does not send "scenario".
# normal | slow-provider | provider-timeout | provider-failure |
# provider-a-failure | provider-c-empty | provider-c-malformed
DEFAULT_SCENARIO=normal

PROVIDER_TIMEOUT_MS=2000          # per-provider timeout enforced by the search service
PROVIDER_C_MAX_CONCURRENT=3       # Provider C active-request limit (rate limiting)
SIMULATED_LATENCY_MULTIPLIER=1    # scale all simulated latencies (tests use 0.1)

# LLM credentials for the recovery agent (candidate task). Not needed to run the starter.
ANTHROPIC_API_KEY=
